<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="Cálculo de Hospedagem"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            
            <Label Text="Calculadora de Hospedagem" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="#1E293B"
                   HorizontalOptions="Center" />

      
            <Label Text="Escolha a suíte:" 
                   FontAttributes="Bold" 
                   TextColor="#475569" />

            <Picker x:Name="pck_quarto" 
                    Title="Selecione o quarto"
                    ItemDisplayBinding="{Binding Descricao}"
                    BackgroundColor="White"
                    TextColor="#1E293B" />

           
            <Frame BackgroundColor="White" CornerRadius="8" Padding="12" HasShadow="False" BorderColor="#E2E8F0">
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Adultos" FontAttributes="Bold" TextColor="#1E293B" />
                        <Label Text="R$ 100,00 a diária" FontSize="12" TextColor="#64748B" />
                    </VerticalStackLayout>

                    
                    <Label x:Name="lbl_adultos" Text="{Binding Source={x:Reference stp_adultos}, Path=Value, StringFormat='{0:F0}'}" 
                           Grid.Column="1" FontSize="18" FontAttributes="Bold" TextColor="#0284C7" VerticalOptions="Center" HorizontalOptions="Center" />

                    <Stepper x:Name="stp_adultos" Grid.Column="2" Minimum="1" Maximum="10" Increment="1" VerticalOptions="Center" />
                </Grid>
            </Frame>

          
            <Frame BackgroundColor="White" CornerRadius="8" Padding="12" HasShadow="False" BorderColor="#E2E8F0">
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Crianças" FontAttributes="Bold" TextColor="#1E293B" />
                        <Label Text="R$ 50,00 a diária" FontSize="12" TextColor="#64748B" />
                    </VerticalStackLayout>

                   
                    <Label x:Name="lbl_criancas" Text="{Binding Source={x:Reference stp_criancas}, Path=Value, StringFormat='{0:F0}'}" 
                           Grid.Column="1" FontSize="18" FontAttributes="Bold" TextColor="#0284C7" VerticalOptions="Center" HorizontalOptions="Center" />

                    <Stepper x:Name="stp_criancas" Grid.Column="2" Minimum="0" Maximum="5" Increment="1" VerticalOptions="Center" />
                </Grid>
            </Frame>

         
            <Frame BackgroundColor="White" CornerRadius="8" Padding="12" HasShadow="False" BorderColor="#E2E8F0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Período da Estadia" FontAttributes="Bold" TextColor="#1E293B" />

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Check-in:" VerticalOptions="Center" TextColor="#475569" WidthRequest="80" />
                        <DatePicker x:Name="dtpck_checkin" DateSelected="dtpck_checkin_DateSelected" HorizontalOptions="FillAndExpand" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Check-out:" VerticalOptions="Center" TextColor="#475569" WidthRequest="80" />
                        <DatePicker x:Name="dtpck_checkout" HorizontalOptions="FillAndExpand" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

           
            <Button Text="Avançar" 
                    BackgroundColor="#0284C7" 
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="48"
                    Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>