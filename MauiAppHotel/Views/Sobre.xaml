<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout Padding="25"
                         Spacing="20"
                         VerticalOptions="Center">

        <Label Text="SOBRE O APLICATIVO"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="{StaticResource PrimaryDark}"
               HorizontalOptions="Center"/>

        <Label Text="MauiAppHotel"
               FontSize="24"
               HorizontalOptions="Center"/>

        <Label Text="Aplicativo desenvolvido para facilitar a contratação de hospedagens."
               FontSize="16"
               HorizontalTextAlignment="Center"/>

       

        <Label Text="Desenvolvedor: Jonathan Gonçalves Santos"
               FontSize="16"
               HorizontalTextAlignment="Center"/>

        <Label Text="Ano de desenvolvimento: 2026"
               FontSize="16"
               HorizontalOptions="Center"/>

        <Button Text="Voltar"
        Clicked="OnVoltarClicked"/>

    </VerticalStackLayout>

</ContentPage>